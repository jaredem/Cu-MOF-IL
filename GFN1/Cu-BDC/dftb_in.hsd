Geometry = GenFormat {
<<< "in.gen"
}

Driver = GeometryOptimisation {
Convergence = {GradElem [ eV/AA] = 0.01}
LatticeOpt = YES
Optimiser = LBFGS {}
}
Hamiltonian = xTB {
Filling = Fermi { Temperature [K] = 300}
KPointsAndWeights = SupercellFolding {
  5 0 0
  0 5 0
  0 0 5
  0.0 0.0 0.0
}
MaxSCCIterations = 500
Method = "GFN1-xTB"
Mixer = Broyden{
MixingParameter = 0.1
}
SCC = YES
SCCTolerance = 1e-07
}
