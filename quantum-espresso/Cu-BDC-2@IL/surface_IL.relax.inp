 &CONTROL
                       title = 'celula da MOF' ,
                 calculation = 'relax' ,
                restart_mode = 'from_scratch' ,
                  wf_collect = .true. ,
                       nstep = 500 ,
                      outdir = '...' ,
                      wfcdir = '...',
                  pseudo_dir = '...' ,
                      prefix = 'surface_IL3' ,
                     tprnfor = .true.,  
                     tstress = .true.,
	           verbosity = 'high',
  /
 
  &SYSTEM
                       ibrav = 0 ,
                         nat = 206,
                        ntyp = 8,
                     ecutwfc = 55 ,
                     ecutrho = 550 ,
                       nosym = .false. ,
                        nbnd = 960 ,
                 occupations = 'smearing',
                    smearing = 'gaussian' ,
                     degauss = 0.01 ,
                       nspin = 2 ,
   starting_magnetization(1) = 0.5 ,
   starting_magnetization(2) = -0.5,
                    vdw_corr = 'DFT-D3' 
/ 
 &ELECTRONS
                 mixing_beta = 0.2 ,
                    conv_thr = 1.0e-6 ,
            electron_maxstep = 1600 ,
           
 /
 &IONS

                ion_dynamics = 'bfgs',
           pot_extrapolation = 'second-order',
           wfc_extrapolation = 'second-order',
/
&CELL
 
/              

