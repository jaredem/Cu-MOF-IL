 &CONTROL
                       title = 'celula da MOF' ,
                 calculation = 'vc-relax' ,
                restart_mode = 'from_scratch' ,
                  wf_collect = .true. ,
                      outdir = '/.../' ,
                      wfcdir = '/.../' ,
                  pseudo_dir = '/.../' ,
                      prefix = '...' ,
		      nstep =  500 ,
                     tprnfor = .true.  
                     tstress = .true.
                   verbosity = 'high' ,
  /
 
&SYSTEM
                       ibrav = 0 ,
                         nat = 116 ,
                        ntyp = 6,
                     ecutwfc = 55 ,
                     ecutrho = 550 ,
                       nosym = .false. ,
                        nbnd = 960 ,
                 occupations = 'smearing',
                    smearing = 'gaussian' ,
                     degauss = 0.01 ,
                       nspin = 2 ,
   starting_magnetization(1) = 1 ,
   starting_magnetization(2) = -1 ,
                  lda_plus_u = .true.
           U_projection_type = 'ortho-atomic' 
                   Hubbard_U(1) = 7.0
                   Hubbard_U(2) = 7.0 
                   Hubbard_J0(1) = 1.0
                   Hubbard_J0(2) = 1.0    
                    vdw_corr = 'DFT-D3' 
/ 
 &ELECTRONS
                 mixing_beta = 0.4 ,
                    conv_thr = 1.0e-6 ,
            electron_maxstep = 1600 ,
             diagonalization = 'cg',
 /
 &IONS

                ion_dynamics = 'bfgs',
           pot_extrapolation = 'second-order',
           wfc_extrapolation = 'second-order',
/
&CELL
	         cell_dofree = 'all', 
               
 /
