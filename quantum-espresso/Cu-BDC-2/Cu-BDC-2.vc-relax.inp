 &CONTROL
                       title = 'celula da MOF' ,
                 calculation = 'vc-relax' ,
                restart_mode = 'from_scratch' ,
                  wf_collect = .true. ,
                       nstep = 500 ,
                      outdir = '/.../' ,
                      wfcdir = '/.../' ,
                  pseudo_dir = '/.../' ,
                      prefix = '...' ,
                     tprnfor = .true.  
                     tstress = .true.
	           verbosity = 'high',
  /
 
  &SYSTEM
                       ibrav = 0 ,
                         nat = 22 ,
                        ntyp = 5,
                     ecutwfc = 55 ,
                     ecutrho = 550 ,
                       nosym = .false. ,
                        nbnd = 960 ,
                 occupations = 'smearing',
                    smearing = 'gaussian' ,
                     degauss = 0.01, 
                       nspin = 2 ,
      starting_magnetization(1) = 0.5 ,
      starting_magnetization(2) = -0.5 ,
                   lda_plus_u = .true.
            U_projection_type = 'ortho-atomic' 
                    Hubbard_U(1) = 7.0
                    Hubbard_U(2) = 7.0
                    Hubbard_J0(1) = 1.0 
                    Hubbard_J0(2) = 1.0
                    vdw_corr = 'grimme-d3',
/ 
 &ELECTRONS
                 mixing_beta = 0.2 ,
                    conv_thr = 1.0e-6 ,
            electron_maxstep = 1600 ,
             diagonalization = 'cg'

 /
 &IONS
 /
 &CELL
 
/              

