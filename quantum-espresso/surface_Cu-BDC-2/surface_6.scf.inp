 &CONTROL
                       title = 'celula da MOF' ,
                 calculation = 'scf' ,
                restart_mode = 'from_scratch' ,
                  wf_collect = .true. ,
                       nstep = 500 ,
                      outdir = '...' ,
                      wfcdir = '...' ,
                  pseudo_dir = '...' ,
                      prefix = 'surface_6' ,  
	           verbosity = 'high',
  /
 
  &SYSTEM
                       ibrav = 0 ,
                         nat = 132,
                        ntyp = 5,
                     ecutwfc = 55 ,
                     ecutrho = 550 ,
                       nosym = .false. ,
                        nbnd = 960 ,
                 occupations = 'smearing',
                    smearing = 'gaussian' ,
                     degauss = 0.01 ,
                       nspin = 2 ,
   starting_magnetization(1) = 0.5 ,
   starting_magnetization(2) = -0.5,
                  lda_plus_u = .true.,
           U_projection_type = 'ortho-atomic', 
                   Hubbard_U(1) = 7.0,
                   Hubbard_U(2) = 7.0, 
                   Hubbard_J0(1) = 1.0, 
                   Hubbard_J0(1) = 1.0, 
                    vdw_corr = 'DFT-D3',
/ 
 &ELECTRONS
                 mixing_beta = 0.2 ,
                    conv_thr = 1.0e-6 ,
            electron_maxstep = 1600 ,
           
 /
 &IONS
           pot_extrapolation = 'second-order',
           wfc_extrapolation = 'second-order',
 /
 &CELL
/              

