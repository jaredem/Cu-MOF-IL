                      prefix = 'CuDMF1' ,
                     tprnfor = .true.  
                     tstress = .true.
                   verbosity = 'high' ,
  /
 
&SYSTEM
                       ibrav = 0 ,
                         nat = 116 ,
                        ntyp = 6,
                     ecutwfc = 55 ,
                     ecutrho = 550 ,
                       nosym = .true. ,
                        nbnd = 960 ,
                 occupations = 'tetrahedra',
                    smearing = 'gaussian' ,
                     degauss = 0.01 ,
                       nspin = 2 ,
   starting_magnetization(1) = 1 ,
   starting_magnetization(2) = -1 ,
                  lda_plus_u = .true.
           U_projection_type = 'ortho-atomic' 
